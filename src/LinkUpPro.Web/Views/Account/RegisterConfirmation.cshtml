@{
    ViewData["Title"] = "Cuenta creada";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm text-center">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">¡Cuenta creada!</h1>
                <p>Su cuenta fue creada correctamente. Hemos enviado un enlace de activación a su correo electrónico.</p>
                <a asp-action="Login" class="btn btn-primary mt-2">Ir al inicio de sesión</a>
            </div>
        </div>
    </div>
</div>
