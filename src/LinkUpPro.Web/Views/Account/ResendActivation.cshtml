@model ResendActivationViewModel
@{
    ViewData["Title"] = "Reenviar correo de activación";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Reenviar correo de activación</h1>
                <p class="text-muted small">
                    Ingrese su nombre de usuario. Si su cuenta todavía no ha sido activada,
                    le enviaremos un nuevo enlace a su correo electrónico.
                </p>

                <form asp-action="ResendActivation" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Login" class="btn btn-outline-secondary">Volver atrás</a>
                        <button type="submit" class="btn btn-primary">Reenviar enlace</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
