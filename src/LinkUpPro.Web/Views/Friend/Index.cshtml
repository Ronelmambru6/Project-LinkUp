@model FriendsIndexViewModel
@{
    ViewData["Title"] = "Amigos";
    var hayBusqueda = !string.IsNullOrWhiteSpace(Model.Search);

    // Filtros de publicaciones activos, para conservarlos al usar el buscador de amigos
    var f = Model.Filtros;
    var filtrosActuales = new Dictionary<string, string?>
    {
        ["Texto"] = f.Texto,
        ["AmigoId"] = f.AmigoId,
        ["TipoContenido"] = f.TipoContenido?.ToString(),
        ["FechaDesde"] = f.FechaDesde?.ToString("yyyy-MM-dd"),
        ["FechaHasta"] = f.FechaHasta?.ToString("yyyy-MM-dd"),
        ["Edicion"] = f.Edicion == LinkUpPro.Application.Dtos.Posts.FiltroEdicion.Todas ? null : f.Edicion.ToString()
    }
    .Where(x => !string.IsNullOrWhiteSpace(x.Value))
    .ToDictionary(x => x.Key, x => x.Value!);
}

<h1 class="h3 mb-4">Amigos</h1>

@* ── Resumen de amistades ── *@
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Total de amigos</div>
                <div class="display-6 fw-semibold">@Model.TotalAmigos</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Publicaciones disponibles</div>
                <div class="display-6 fw-semibold">@Model.PublicacionesDisponibles</div>
            </div>
        </div>
    </div>
</div>

@* ── Publicaciones de amigos ── *@
<section class="mb-4" aria-labelledby="titulo-publicaciones">
    <h2 id="titulo-publicaciones" class="h5 mb-3">Publicaciones de amigos</h2>

    @if (Model.AmigosFiltro.Count == 0)
    {
        <div class="alert alert-info" role="status">Todavía no tiene amigos agregados.</div>
    }
    else
    {
        <partial name="_FriendPostFilters" model="Model" />

        @if (Model.Publicaciones.Count == 0)
        {
            <div class="alert alert-info" role="status">
                @(Model.BusquedaConFiltros
                    ? "No se encontraron publicaciones que coincidan con los criterios seleccionados."
                    : "Sus amigos todavía no han realizado publicaciones disponibles para usted.")
            </div>
        }
        else
        {
            foreach (var publicacion in Model.Publicaciones)
            {
                <partial name="_Post" model="publicacion" />
            }
        }
    }
</section>

@* ── Listado de amigos ── *@
<section class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">Mis amigos</h2>
    </div>
    <div class="card-body">
        @* Buscador por nombre, apellido o nombre de usuario (GET: no modifica nada) *@
        <form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
            @foreach (var (nombre, valor) in filtrosActuales)
            {
                <input type="hidden" name="@nombre" value="@valor" />
            }
            <div class="col-sm">
                <label for="search" class="visually-hidden">Criterio de búsqueda</label>
                <input id="search" name="search" value="@Model.Search" class="form-control"
                       placeholder="Buscar por nombre, apellido o nombre de usuario" />
            </div>
            <div class="col-sm-auto d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
                <a asp-action="Index" asp-all-route-data="filtrosActuales" class="btn btn-outline-secondary">Limpiar búsqueda</a>
            </div>
        </form>

        @if (!Model.Amigos.Any())
        {
            <p class="text-muted mb-0">
                @(hayBusqueda
                    ? "No se encontraron amigos que coincidan con el criterio ingresado."
                    : "Todavía no tiene amigos agregados.")
            </p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var amigo in Model.Amigos)
                {
                    <li class="list-group-item px-0">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <img src="@amigo.Usuario.FotoPerfil" alt="Foto de @amigo.Usuario.UserName"
                                 class="rounded-circle object-fit-cover" width="56" height="56" />
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@amigo.Usuario.Nombre @amigo.Usuario.Apellido</div>
                                <a asp-action="Profile" asp-route-id="@amigo.Usuario.Id" class="small">@@@amigo.Usuario.UserName</a>
                                <div class="small">
                                    <a asp-action="MutualFriends" asp-route-id="@amigo.Usuario.Id">
                                        @amigo.AmigosEnComun amigo(s) en común
                                    </a>
                                </div>
                            </div>
                            <a asp-action="Remove" asp-route-id="@amigo.Usuario.Id" class="btn btn-outline-danger btn-sm">Eliminar amigo</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>
