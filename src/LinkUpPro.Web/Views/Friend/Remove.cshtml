@model RemoveFriendViewModel
@{
    ViewData["Title"] = "Eliminar amigo";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm text-center">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Eliminar amigo</h1>
                <p class="mb-4">¿Está seguro que desea eliminar de sus amigos al usuario @Model.UserName?</p>

                @* Se confirma por POST con antiforgery; el Id del usuario autenticado sale de la sesión *@
                <form asp-action="Remove" asp-route-id="@Model.FriendId" method="post"
                      class="d-flex justify-content-center gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>
