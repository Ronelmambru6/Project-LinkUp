@using LinkUpPro.Application.ViewModels.Battleship
@model TableroViewModel
@{
    ViewData["Title"] = "Mi tablero";
}

<h1 class="h3 mb-3">Mi tablero</h1>

<partial name="_Board" model="Model" />

<div class="bs-legend mt-3 mb-3">
    <span><span class="bs-cell bs-ship"></span>Mis barcos</span>
    <span><span class="bs-cell bs-empty"></span>Agua</span>
</div>

<a asp-action="Attack" asp-route-id="@Model.GameId" class="btn btn-outline-secondary">Volver</a>
