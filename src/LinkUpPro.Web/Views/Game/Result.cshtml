@using LinkUpPro.Application.ViewModels.Battleship
@model ResultadoViewModel
@{
    ViewData["Title"] = "Resultado";
}

<h1 class="h3 mb-1">Resultado de la partida</h1>
<p class="text-muted">Contra @@@Model.Oponente.UserName · Ganador: <strong>@Model.Ganador</strong></p>

@if (Model.Gane)
{
    <div class="alert alert-success" role="status">Ganó la partida.</div>
}
else
{
    <div class="alert alert-danger" role="status">Perdió la partida.</div>
}

<div class="row g-4 mb-3">
    <div class="col-xl-4"><partial name="_Board" model="Model.MiAtaque" /></div>
    <div class="col-xl-4"><partial name="_Board" model="Model.AtaqueOponente" /></div>
    <div class="col-xl-4"><partial name="_Board" model="Model.MiPosicionamiento" /></div>
</div>

<div class="bs-legend mb-3">
    <span><span class="bs-cell bs-hit"></span>Acierto</span>
    <span><span class="bs-cell bs-miss"></span>Fallo</span>
    <span><span class="bs-cell bs-ship"></span>Barco</span>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
