@using LinkUpPro.Application.ViewModels.Battleship
@model RendirseViewModel
@{
    ViewData["Title"] = "Rendirse";
}

<h1 class="h3 mb-4">Rendirse</h1>

<div class="alert alert-warning" role="alert">
    ¿Está seguro que desea rendirse?
    <div class="small mt-1">Perderá la partida contra @@@Model.Oponente.UserName.</div>
</div>

<form asp-action="Surrender" asp-route-id="@Model.GameId" method="post">
    <button type="submit" class="btn btn-danger">Aceptar</button>
    @if (Model.Origen == "ataque")
    {
        <a asp-action="Attack" asp-route-id="@Model.GameId" class="btn btn-outline-secondary">Cancelar</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    }
</form>
