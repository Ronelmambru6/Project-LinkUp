@{
    // Sin el layout principal: el menú consulta la base de datos (contadores),
    // y si el error vino de la base de datos, el layout también fallaría.
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - LinkUp Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-4">
                    <h1 class="h4 mb-3">LinkUp Pro</h1>
                    <p class="mb-4">@ViewData["Mensaje"]</p>
                    <a href="/" class="btn btn-primary">Ir al inicio</a>
                </div>
            </div>
        </div>
    </div>
</main>
</body>
</html>