@using LinkUpPro.Application.ViewModels.Posts
@using LinkUpPro.Domain.Enums
@model PostViewModel

<article class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            @* Publicaciones de amigos: la foto y el usuario enlazan al perfil del amigo *@
            @if (Model.PuedeVerPerfilAutor)
            {
                <a asp-controller="Friend" asp-action="Profile" asp-route-id="@Model.AutorId" class="me-3">
                    <img src="@Model.Autor.FotoPerfil" alt="Foto de perfil de @Model.Autor.UserName"
                         class="rounded-circle object-fit-cover" width="48" height="48" />
                </a>
            }
            else
            {
                <img src="@Model.Autor.FotoPerfil" alt="Foto de perfil de @Model.Autor.UserName"
                     class="rounded-circle object-fit-cover me-3" width="48" height="48" />
            }
            <div class="flex-grow-1">
                @if (Model.PuedeVerPerfilAutor)
                {
                    <div class="fw-semibold">@Model.Autor.NombreCompleto</div>
                    <a asp-controller="Friend" asp-action="Profile" asp-route-id="@Model.AutorId" class="small">@@@Model.Autor.UserName</a>
                }
                else
                {
                    <div class="fw-semibold">@@@Model.Autor.UserName</div>
                }
                <div class="text-muted small">
                    @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")
                    @if (Model.Editada)
                    {
                        <span class="badge text-bg-secondary ms-1">Editada</span>
                    }
                </div>
            </div>
            <span class="badge text-bg-light border">@Model.PrivacidadTexto</span>
        </div>

        <p class="card-text" style="white-space: pre-line;">@Model.Contenido</p>

        @if (Model.TipoContenido == TipoContenido.Imagen && !string.IsNullOrEmpty(Model.RutaImagen))
        {
            <img src="@Model.RutaImagen" alt="Imagen de la publicación" class="img-fluid rounded mb-3" style="max-height: 480px;" />
        }
        else if (Model.TipoContenido == TipoContenido.YouTube && Model.YouTubeEmbedUrl is not null)
        {
            <div class="ratio ratio-16x9 mb-3">
                <iframe src="@Model.YouTubeEmbedUrl" title="Video de YouTube" loading="lazy"
                        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        }

        <div class="d-flex flex-wrap gap-3 text-muted small">
            <span>Me gusta: @Model.MeGusta</span>
            <span>No me gusta: @Model.NoMeGusta</span>
            <span>Comentarios: @Model.Comentarios</span>
            <span>@Model.ComentariosTexto</span>
        </div>

        @if (!Model.PermitirComentarios)
        {
            <div class="form-text">Los comentarios están desactivados para esta publicación.</div>
        }

        @{
            // En el Home y en Amigos (listado y perfil) cada publicación enlaza a su detalle,
            // donde están los comentarios y las reacciones
            var enHome = (Context.Request.RouteValues["controller"] as string) is "Home" or "Friend";
        }

        @if (Model.EsAutor || enHome)
        {
            <div class="mt-3 d-flex gap-2">
                @if (enHome)
                {
                    <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">Ver comentarios y reacciones</a>
                }
                @if (Model.EsAutor)
                {
                    <a asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <a asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                }
            </div>
        }
    </div>
</article>
